# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace YOUR_PASSWORD with the password you chose when installing PostgreSQL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hams?schema=public"

# Secret used to sign login tokens. Use a long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Cookie flag "Secure" (HTTPS only). Keep false on localhost, true in production.
COOKIE_SECURE=false

# bcrypt cost factor (12 is a good default)
BCRYPT_ROUNDS=12

# Background job that marks missed appointments as No Show
ENABLE_JOBS=true
