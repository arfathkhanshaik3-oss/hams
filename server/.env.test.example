# Copy to ".env.test". Use a SEPARATE database - the tests DELETE all data in it!
# Create it once in pgAdmin or with:  createdb -U postgres hams_test
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hams_test?schema=public"
JWT_SECRET="test-secret-test-secret-test-secret"
NODE_ENV=test
CLIENT_URL="http://localhost:5173"
BCRYPT_ROUNDS=4
RATE_LIMIT_DISABLED=true
ENABLE_JOBS=false
